{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "functions": {
    "index.js": {
      "memory": 3008,
      "maxDuration": 300
    }
  },
  "buildCommand": "npm install && npx playwright install --with-deps chromium",
  "installCommand": "npm install"
}
